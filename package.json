{
  "name": "gpx-privacy-cleaner",
  "version": "1.0.2",
  "description": "Privacy-first, 100% in-browser tool that strips your home location and personal metadata out of GPX (GPS track) files before you share them. Nothing is ever uploaded.",
  "type": "module",
  "license": "MIT",
  "author": "Skytuhua",
  "homepage": "https://skytuhua.github.io/gpx-privacy-cleaner/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Skytuhua/gpx-privacy-cleaner.git"
  },
  "keywords": [
    "gpx",
    "gps",
    "privacy",
    "strava",
    "garmin",
    "anonymize",
    "metadata",
    "in-browser",
    "offline"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-no-network.mjs",
    "check:offline": "node scripts/check-no-network.mjs",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@fontsource/inter": "5.1.0",
    "@fontsource/jetbrains-mono": "5.1.1",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "8.18.0",
    "@typescript-eslint/parser": "8.18.0",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "jsdom": "25.0.1",
    "postcss": "^8.5.15",
    "prettier": "3.4.2",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.2",
    "vite": "^5.4.21",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "esbuild": "^0.25.0"
  }
}
